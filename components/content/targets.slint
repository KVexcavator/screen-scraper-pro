import { ListView } from "std-widgets.slint";

export component TargetsView inherits VerticalLayout {
    in property <[string]> targets;

    padding: 12px;
    spacing: 8px;

    Text {
        text: "Доступные цели:";
        font-size: 16px;
    }

    ListView {
        for target in targets : Text {
            text: target;
        }
    }
}